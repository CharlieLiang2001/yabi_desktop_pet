# Normalize future text changes; existing working files are not rewritten.
* text=auto
*.cs text eol=crlf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.manifest text eol=crlf
*.png binary
*.jpg binary
*.ico binary
*.mp4 binary
*.zip binary
*.exe binary
